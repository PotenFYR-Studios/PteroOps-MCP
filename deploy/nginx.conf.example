# Reverse proxy example: nginx in front of PteroOps (HTTP transport).
#
#   pteroops --transport http        # listens on 127.0.0.1:8080 by default
#
# Set PTERO_HTTP_TOKEN and pass it as a bearer token. Only expose /mcp and /ui
# through the proxy; keep /metrics internal unless you want Prometheus scraping.

upstream pteroops {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name pteroops.example.com;

    ssl_certificate     /etc/letsencrypt/live/pteroops.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pteroops.example.com/privkey.pem;

    # Streamable HTTP needs SSE support: buffering off, long reads enabled.
    location /mcp {
        proxy_pass http://pteroops;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /ui {
        proxy_pass http://pteroops;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health { proxy_pass http://pteroops; }
    location = /ready  { proxy_pass http://pteroops; }
}

# Notes
# - PteroOps already requires Authorization: Bearer <PTERO_HTTP_TOKEN> for non-loopback
#   binds; the proxy adds TLS. Do not strip the Authorization header.
# - For the web console, open https://pteroops.example.com/ui?token=... once; the
#   session cookie is scoped to /ui.
# - Prometheus scraping from inside the network can hit 127.0.0.1:8080/metrics directly.
