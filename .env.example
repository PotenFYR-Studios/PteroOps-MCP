# Copy to .env and fill in. Never commit the real .env file.

# Panels (env bootstrap; alternatively use pteroops.config.yaml)
PTERO_PANEL_PROD_URL=https://panel.example.com
PTERO_PANEL_PROD_CLIENT_KEY=ptlc_replace_me
PTERO_PANEL_PROD_APPLICATION_KEY=ptla_replace_me
PTERO_DEFAULT_PANEL=prod

# Storage
PTERO_DATA_DIR=./data

# Logging
PTERO_LOG_LEVEL=info
PTERO_LOG_PRETTY=0

# Monitoring
PTERO_MONITORING_ENABLED=1
PTERO_MONITORING_INTERVAL=30

# HTTP transport (required to be set when binding non-loopback)
# PTERO_HTTP_HOST=127.0.0.1
# PTERO_HTTP_PORT=8080
# PTERO_HTTP_TOKEN=replace_with_a_long_random_token
